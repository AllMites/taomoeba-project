{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "investigationId": {
      "type": "string"
    },
    "habitat": {
      "type": "string",
      "enum": [
        "iss",
        "moon",
        "rover",
        "mars",
        "suit-ref"
      ]
    },
    "overlap": {
      "type": [
        "number",
        "null"
      ]
    },
    "dimsUsed": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "siRelevance": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "score": {
      "type": "number"
    },
    "rationale": {
      "type": "string"
    },
    "claimIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "string",
      "enum": [
        "measured",
        "interpolated",
        "extrapolated",
        "illustrative"
      ]
    }
  },
  "required": [
    "id",
    "investigationId",
    "habitat",
    "overlap",
    "dimsUsed",
    "siRelevance",
    "score",
    "rationale",
    "claimIds",
    "provenance"
  ],
  "additionalProperties": false
}
