{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "investigationId": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "summary",
        "finding",
        "rationale",
        "takeaway"
      ]
    },
    "habitat": {
      "type": "string",
      "enum": [
        "iss",
        "moon",
        "rover",
        "mars",
        "suit-ref"
      ]
    },
    "text": {
      "type": "string"
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excerpt": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "supports",
        "contradicts",
        "unrelated"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "flagged": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "investigationId",
    "kind",
    "text",
    "sourceIds",
    "excerpt"
  ],
  "additionalProperties": false
}
